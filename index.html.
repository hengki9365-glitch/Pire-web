</style>


<script>
(function(){


  var slides = [
    {type:"analog-round",caption:"Analog Clock + Calendar"},
    {type:"digital-horizontal",caption:"Digital Horizontal + Calendar"},
    {type:"digital-stacked",caption:"Digital Stacked + Calendar"},
    {type:"analog-square",caption:"Analog Square + Calendar"},
    {type:"digital-date",caption:"Digital + Date"},
    {type:"digital-full",caption:"Digital Fullscreen"}
  ];

  var current=0;
  var live=document.getElementById('pireLivePreview');
  var caption=document.getElementById('pirePreviewCaption');
  var prev=document.getElementById('pirePrev');
  var next=document.getElementById('pireNext');
  var dots=document.querySelectorAll('#pireDots .pire-dot');
  var touchArea=document.getElementById('pirePreviewTouch');
  var timer=null;

  function p2(n){ return String(n).padStart(2,'0'); }

  function parts(now){
    return {hh:p2(now.getHours()),mm:p2(now.getMinutes()),ss:p2(now.getSeconds())};
  }

  function dateLong(now){
    return now.toLocaleDateString('en-US',{
      weekday:'long',day:'numeric',month:'long',year:'numeric'
    });
  }

  function dateShort(now){
    return now.toLocaleDateString('en-US',{
      weekday:'long',day:'numeric',month:'long'
    });
  }

  function monthTitle(now){
    return now.toLocaleDateString('en-US',{month:'long',year:'numeric'});
  }

  function calendarHtml(now){
    var y=now.getFullYear();
    var m=now.getMonth();
    var today=now.getDate();
    var firstNative=new Date(y,m,1).getDay();
    var first=(firstNative+6)%7; /* Monday first, same as Android source */
    var days=new Date(y,m+1,0).getDate();
    var html='<div class="pire-calendar">';
    html+='<div class="pire-calendar-title">'+monthTitle(now)+'</div>';
    html+='<div class="pire-calendar-week">';
    ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(function(d){ html+='<div>'+d+'</div>'; });
    html+='</div><div class="pire-calendar-grid">';
    for(var cell=0;cell<42;cell++){
      var day=cell-first+1;
      if(day>=1 && day<=days){
        html+='<div class="pire-cal-cell"><div class="pire-cal-day'+(day===today?' today':'')+'">'+day+'</div></div>';
      }else{
        html+='<div class="pire-cal-cell"></div>';
      }
    }
    html+='</div></div>';
    return html;
  }

  function point(angle,distance,square){
    var rad=angle*Math.PI/180;
    var dx=Math.sin(rad),dy=-Math.cos(rad);
    var adj=square?Math.max(Math.abs(dx),Math.abs(dy)):1;
    return [500+dx*distance/adj,500+dy*distance/adj];
  }

  function line(x1,y1,x2,y2,cls,width){
    return '<line x1="'+x1.toFixed(2)+'" y1="'+y1.toFixed(2)+'" x2="'+x2.toFixed(2)+'" y2="'+y2.toFixed(2)+'" class="'+cls+'"'+(width?' stroke-width="'+width+'"':'')+'/>';
  }

  function analogSvg(square){
    var radius=475;
    var svg='<svg class="pire-analog-svg" viewBox="0 0 1000 1000" aria-hidden="true">';
    if(square){
      svg+='<rect x="25" y="25" width="950" height="950" rx="45" class="pire-analog-frame" stroke-width="5"/>';
    }else{
      svg+='<circle cx="500" cy="500" r="474.25" class="pire-analog-frame" stroke-width="6.5"/>';
    }

    for(var tick=0;tick<60;tick++){
      var hourTick=tick%5===0;
      var angle=tick*6;
      var outer=radius*.91;
      var inner=radius*(hourTick?.80:.86);
      var a=point(angle,inner,square),b=point(angle,outer,square);
      svg+=line(a[0],a[1],b[0],b[1],hourTick?'pire-analog-tick-hour':'pire-analog-tick-minute');
    }

    [[12,0],[3,90],[6,180],[9,270]].forEach(function(item){
      var p=point(item[1],radius*.63,false);
      svg+='<text x="'+p[0].toFixed(2)+'" y="'+p[1].toFixed(2)+'">'+item[0]+'</text>';
    });

    svg+='<line data-hour-neutral x1="500" y1="500" x2="500" y2="276.75" class="pire-hand-neutral" stroke-width="21"/>';
    svg+='<line data-minute-neutral x1="500" y1="500" x2="500" y2="162.75" class="pire-hand-neutral" stroke-width="14"/>';
    svg+='<line data-hour-accent x1="500" y1="462" x2="500" y2="300.5" class="pire-hand-accent" stroke-width="5.5"/>';
    svg+='<line data-minute-accent x1="500" y1="462" x2="500" y2="186.5" class="pire-hand-accent" stroke-width="3.5"/>';
    svg+='<line data-second x1="500" y1="557" x2="500" y2="134.25" class="pire-second-hand"/>';
    svg+='<circle cx="500" cy="500" r="21" class="pire-pivot"/>';
    svg+='</svg>';
    return svg;
  }

  function screenHtml(type,now){
    var t=parts(now);
    var hm=t.hh+':'+t.mm;

    if(type==='digital-full'){
      return '<div class="pire-live-screen"><div class="pire-mode-full"><div class="pire-original-digital" data-time>'+hm+'</div></div></div>';
    }

    if(type==='digital-date'){
      return '<div class="pire-live-screen"><div class="pire-mode-date">'+
        '<div class="pire-original-digital" data-time>'+hm+'</div>'+
        '<div class="pire-original-date" data-date-long>'+dateLong(now)+'</div>'+
      '</div></div>';
    }

    if(type==='digital-horizontal'){
      return '<div class="pire-live-screen"><div class="pire-original-row">'+
        '<div class="pire-original-left"><div class="pire-horizontal-clock">'+
          '<div class="pire-original-digital" data-time>'+hm+'</div>'+
          '<div class="pire-original-date" data-date-short>'+dateShort(now)+'</div>'+
        '</div></div>'+
        '<div class="pire-original-right" data-calendar>'+calendarHtml(now)+'</div>'+
      '</div></div>';
    }

    if(type==='digital-stacked'){
      return '<div class="pire-live-screen"><div class="pire-original-row">'+
        '<div class="pire-original-left"><div class="pire-stacked-clock">'+
          '<div class="pire-stack-main"><span data-hour>'+t.hh+'</span><span data-minute>'+t.mm+'</span></div>'+
          '<div class="pire-stack-detail" data-stacked-second>'+t.ss+'</div>'+
        '</div></div>'+
        '<div class="pire-original-right" data-calendar>'+calendarHtml(now)+'</div>'+
      '</div></div>';
    }

    var square=type==='analog-square';
    return '<div class="pire-live-screen"><div class="pire-original-row">'+
      '<div class="pire-original-left"><div class="pire-analog-wrap">'+analogSvg(square)+'</div></div>'+
      '<div class="pire-original-right" data-calendar>'+calendarHtml(now)+'</div>'+
    '</div></div>';
  }

  function rotateLine(el,deg){
    if(el){ el.setAttribute('transform','rotate('+deg+' 500 500)'); }
  }

  function updateAnalog(now){
    var sec=now.getSeconds()+now.getMilliseconds()/1000;
    var min=now.getMinutes()+sec/60;
    var hour=(now.getHours()%12)+min/60;
    rotateLine(live.querySelector('[data-hour-neutral]'),hour*30);
    rotateLine(live.querySelector('[data-minute-neutral]'),min*6);
    rotateLine(live.querySelector('[data-hour-accent]'),hour*30);
    rotateLine(live.querySelector('[data-minute-accent]'),min*6);
    rotateLine(live.querySelector('[data-second]'),sec*6);
  }

  function refresh(){
    if(!live){return;}
    var now=new Date(),t=parts(now),slide=slides[current];

    var time=live.querySelector('[data-time]');
    if(time){ time.textContent=t.hh+':'+t.mm; }
    var hour=live.querySelector('[data-hour]');
    var minute=live.querySelector('[data-minute]');
    var stackedSecond=live.querySelector('[data-stacked-second]');
    if(hour){hour.textContent=t.hh;}
    if(minute){minute.textContent=t.mm;}
    if(stackedSecond){stackedSecond.textContent=t.ss;}

    var dl=live.querySelector('[data-date-long]');
    var ds=live.querySelector('[data-date-short]');
    if(dl){dl.textContent=dateLong(now);}
    if(ds){ds.textContent=dateShort(now);}

    if(slide.type.indexOf('analog-')===0){ updateAnalog(now); }

    var cal=live.querySelector('[data-calendar]');
    if(cal){
      var stamp=now.getFullYear()+'-'+now.getMonth()+'-'+now.getDate();
      if(cal.getAttribute('data-stamp')!==stamp){
        cal.innerHTML=calendarHtml(now);
        cal.setAttribute('data-stamp',stamp);
      }
    }
  }

  function startTimer(){
    if(timer){clearInterval(timer);}
    refresh();
    timer=setInterval(refresh,100);
  }

  function renderSlide(index){
    var now=new Date();
    live.innerHTML=screenHtml(slides[index].type,now);
    caption.textContent=slides[index].caption;
    for(var i=0;i<dots.length;i++){dots[i].classList.remove('active');}
    if(dots[index]){dots[index].classList.add('active');}
    startTimer();
  }

  function goTo(index){
    if(index<0){index=slides.length-1;}
    if(index>=slides.length){index=0;}
    current=index;
    renderSlide(current);
  }

  if(prev){prev.addEventListener('click',function(){goTo(current-1);});}
  if(next){next.addEventListener('click',function(){goTo(current+1);});}
  for(let i=0;i<dots.length;i++){
    dots[i].addEventListener('click',function(){goTo(i);});
  }

  var startX=0,endX=0;
  if(touchArea){
    touchArea.addEventListener('touchstart',function(e){
      startX=e.changedTouches[0].clientX;
    },{passive:true});
    touchArea.addEventListener('touchend',function(e){
      endX=e.changedTouches[0].clientX;
      var diff=endX-startX;
      if(Math.abs(diff)>40){goTo(diff<0?current+1:current-1);}
    },{passive:true});
  }

  renderSlide(current);

})();
</script>
</body>
